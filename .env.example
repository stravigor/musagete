# --- Application -------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:3000

# --- HTTP --------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
DOMAIN=localhost

# --- Database (PostgreSQL ≥ 18; pgvector enabled by slice 005/007) -----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=musagete
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20

# Multi-tenant (RLS) — flips on with slice 002. The bypass role must be a
# separate Postgres role with BYPASSRLS; `@strav/database` uses it for
# migrations, TenantManager operations, and `withoutTenant(...)` blocks.
# Create with: CREATE ROLE postgres_bypass WITH LOGIN BYPASSRLS PASSWORD '...';
DB_TENANT_ENABLED=false
DB_BYPASS_USER=postgres_bypass
DB_BYPASS_PASSWORD=

# --- Mail (@strav/signal) ----------------------------------------------------
# MAIL_DRIVER: log | smtp | resend | sendgrid | mailgun
MAIL_DRIVER=log
MAIL_FROM=noreply@localhost
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- OAuth (@strav/social) ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# --- Search (@strav/search; populated when slice 005 ships) ------------------
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_MASTER_KEY=

# --- AI (@strav/brain + @strav/rag; populated when slice 005/007 ship) -------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MUSAGETE_AI_PROVIDER=anthropic
# MUSAGETE_AI_MODEL=claude-opus-4-7
# MUSAGETE_EMBED_MODEL=text-embedding-3-small
