    "#config/*": "./config/*.ts",
    "#start/*": "./start/*.ts"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.14.0",
    "@strav/auth": "link:@strav/auth",
    "@strav/cli": "link:@strav/cli",
    "@strav/database": "link:@strav/database",
    "@strav/http": "link:@strav/http",
    "@strav/kernel": "link:@strav/kernel",
    "@strav/signal": "link:@strav/signal",
    "@strav/social": "link:@strav/social",
    "@strav/view": "link:@strav/view",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "shiki": "^4.0.2",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@strav/testing": "link:@strav/testing",
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "playwright-core": "^1.59.1",
    "typescript": "^5.9.3"
  }
