{
  "name": "musagete",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/http/controllers/*.ts",
    "#middleware/*": "./app/http/middleware/*.ts",
    "#policies/*": "./app/policies/*.ts",
    "#services/*": "./app/services/*.ts",
    "#models/*": "./app/models/*.ts",
    "#enums/*": "./app/enums/*.ts",
    "#jobs/*": "./app/jobs/*.ts",
    "#schemas/*": "./database/schemas/*.ts",
