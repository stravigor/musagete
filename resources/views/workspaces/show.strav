@layout('layouts/app')

@section('content')
  <h1>{{ workspace.name }}</h1>
  <p class="meta">
    <code>/{{ workspace.slug }}</code>
    · you're signed in as <strong>{{ user.email }}</strong>
    · role: {{ membershipRole }}
  </p>

  <h2>Spaces</h2>
  @if (spaces.length === 0)
    <p>
      No spaces yet. <a href="/workspaces/{{ workspace.slug }}/spaces/new">Create your first space</a>
      to seed a folder tree from one of six templates.
    </p>
  @else
    <ul class="spaces">
      @each space in spaces
        <li>
          <a href="/workspaces/{{ workspace.slug }}/spaces/{{ space.slug }}">
            <strong>{{ space.name }}</strong>
          </a>
          <span class="space-meta">
            template: {{ space.template }} · visibility: {{ space.visibility }}
          </span>
        </li>
      @end
    </ul>
    <p>
      <a class="btn" href="/workspaces/{{ workspace.slug }}/spaces/new">+ New space</a>
    </p>
  @end
@end
